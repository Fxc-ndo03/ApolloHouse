# Juana Client Configuration
# Copy to .env and fill in your values

# Apollo Worker WebSocket URL
APOLLO_WORKER_URL=wss://apollo.facupapollo.workers.dev/agents/apollo/default

# Device shared secret (from Cloudflare Worker secrets)
DEVICE_SHARED_SECRET=your-device-shared-secret-here

# Core Local (LAN): cuando USE_LOCAL_CORE=true, el cliente NO usa el Worker;
# se conecta directo a Apollo Core en la red local con este token.
USE_LOCAL_CORE=true
CORE_LAN_URL=ws://192.168.100.8:9876

# Wake word settings
# Comma-separated list of wake words (default: "okey trae")
WAKE_WORDS=okey trae

# Directory containing Vosk models (default: juana_client/models/)
# WAKE_MODEL_DIR=/path/to/vosk/models

# Use Vosk for wake word detection (default: true)
# Set to "false" to disable Vosk and use manual fallback
USE_VOSK_WAKE=true

# Double-clap trigger (default: true). Two claps abort current speech.
CLAP_ENABLED=true

# Fixed RMS floor for clap spikes (default: 0 = adaptive baseline x4).
# Raise it (e.g. 1500) if the room is noisy and you get false triggers.
# CLAP_THRESHOLD_RMS=0