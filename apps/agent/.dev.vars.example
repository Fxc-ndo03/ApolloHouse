DEVICE_SHARED_SECRET=dev-change-me
DASHBOARD_SHARED_SECRET=dev-dashboard-change-me
GEMINI_API_KEY=
TAVILY_API_KEY=
RESEND_API_KEY=
# Where send_email and research reports deliver. With Resend's sandbox sender
# this must be the address you signed up to Resend with.
APOLLO_OWNER_EMAIL=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
MOCK_VOICE=1

# Diagnósticos. Vacíos = apagados, que es como deben estar en cualquier deploy.
#
# MOBILE_SESSION_INSPECTOR=enabled publica el roster de sesiones del bridge
# mobile en /agents/mobile-bridge/mobile/__inspect: el deviceId, la presencia y
# las capabilities de todos los teléfonos. Se abre con el secreto global por
# `?token=` y una credencial de teléfono NO lo abre. Es HTTP, no WebSocket.
#
# APOLLO_TOOL_HARNESS=enabled expone /agents/apollo/__tool-harness para pruebas.
# Es superficie de ejecución de herramientas: dejala prendida sólo mientras
# corrés pruebas, nunca en un deploy que Ataprecea strangers.
MOBILE_SESSION_INSPECTOR=
APOLLO_TOOL_HARNESS=

# Remote one-time setup (when you deploy):
# bunx wrangler vectorize create apollo-memory --dimensions=1536 --metric=cosine
# bunx wrangler r2 bucket create apollo-media
# bunx wrangler queues create apollo-jobs
#
# Every value above is a secret in production: pipe each one through
# `bunx wrangler secret put <NAME>` (except MOCK_VOICE, which is dev-only).
#
# Sandbox (Containers) needs Docker running for wrangler deploy / local container runs.
# Base image: cloudflare/sandbox matching @cloudflare/sandbox (see Dockerfile).
#
# Coding tasks commit as a GitHub App, not as you. Create one (Contents: read &
# write, Pull requests: read & write, Metadata: read), install it on the repos
# Apollo may touch, and paste its id and PEM above. The set of repos it is
# installed on is the allowlist: anything else fails before a container starts.
#
# GitHub hands out a PKCS#1 key ("BEGIN RSA PRIVATE KEY") and WebCrypto needs
# PKCS#8, so convert it first:
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in key.pem -out key-pkcs8.pem
