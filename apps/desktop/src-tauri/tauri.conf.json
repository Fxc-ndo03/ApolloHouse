{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apollo Desktop",
  "version": "0.1.1",
  "identifier": "com.apollo.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "bun run build && bun ../src-tauri/bundle-resources.mjs && bun ../src-tauri/bundle-python-runtime.mjs",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Apollo",
        "url": "/",
        "width": 1000,
        "height": 650,
        "minWidth": 750,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/juana-client",
      "resources/python-runtime"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "allowDowngrades": true,
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1ODk2RUY2OEVBMUYwMjYKUldRbThLR085bTZKUlZaRkpRaTY4QmpFZWY1QmF1ZGZwOFg3S3Zoa1F0b2pPY2Q5aWhGWkE4Tm0K",
      "endpoints": [
        "https://github.com/Fxc-ndo03/ApolloHouse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
