<?xml version="1.0" encoding="utf-8"?>
<!-- Sin atributo `package`: desde AGP 8 el namespace se declara en
     app/build.gradle y el atributo del manifiesto es un error. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- POST_NOTIFICATIONS solo se pide en API 33+; en API 25 el permiso no
         existe y el manifiesto lo ignora. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- BLOCK 12.5.2: el par que exige Android para el foreground service. Son
         permisos normales (se conceden en la instalacion, nadie los revoca) y
         no habilitan nada por si solos: FOREGROUND_SERVICE permite el estado,
         FOREGROUND_SERVICE_SPECIAL_USE permite ese TIPO en API 34+. Sin el
         segundo, startForeground lanza SecurityException en el Moto G35. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- FASE 3.1: pedir instalar el APK actualizado. Android NO concede este
         permiso en la instalacion y NO permite usarlo en silencio: la app
         comprueba si esta habilitado y, si no, manda a la persona a la pantalla
         del sistema que lo gestiona. Es un permiso especial, no uno peligroso. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ApolloApplication"
        android:allowBackup="false"
        android:label="Apollo"
        android:supportsRtl="true">
        <!-- Comparte el APK descargado con el instalador del sistema. Sin un
             FileProvider no se puede abrir un archivo de cache desde otra app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          FASE 3.16: navegacion real del producto. `MainActivity` es solo un
          router: decide entre acceso y producto y termina. Las pantallas viven
          separadas, igual que en escritorio.
        -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="Apollo"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ShellActivity"
            android:exported="false"
            android:label="Apollo"
            android:windowSoftInputMode="adjustResize" />
        <!--
          Pantalla TECNICA (host del Worker, id del telefono, enrolar,
          conectar). Antes era la portada; ahora se llega desde Ajustes.
        -->
        <activity
            android:name=".DeviceActivity"
            android:exported="false"
            android:label="Dispositivo"
            android:windowSoftInputMode="adjustResize" />
        <!--
          Conversacion con Apollo. `exported=false`: nadie fuera de la app puede
          abrirla ni inyectarle un intent. El launcher sigue siendo MainActivity,
          que es la pantalla de conexion y enrollment.
        -->
        <activity
            android:name=".conversation.ConversationActivity"
            android:exported="false"
            android:label="Apollo"
            android:windowSoftInputMode="adjustResize" />
        <!--
          FASE 6.1 · Etapa 2: host del WebView con la interfaz React
          empaquetada. Se AGREGA, no sustituye: LoginActivity, ShellActivity,
          DeviceActivity y ConversationActivity siguen declaradas igual.
          `exported=false`: nadie fuera de esta app puede abrirla ni inyectarle
          un intent; el unico camino es el selector de MainActivity. En esta
          etapa no hay puente: no registra ninguna interfaz JavaScript.
        -->
        <activity
            android:name=".webview.ApolloWebActivity"
            android:exported="false"
            android:label="Apollo"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".MobileService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- La declaracion de subtipo que API 34+ exige para specialUse.
                 "persistent_agent_session" describe el uso real: sostener el
                 socket con el Worker mientras la app no esta visible. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_agent_session" />
        </service>
        <!-- BLOCK 12.4: el receptor de la alarma NO estaba declarado. El Intent
             del PendingIntent apuntaba a una clase que el sistema no conocia, asi
             que la alarma se programaba, `setAlarm` devolvia true y no pasaba
             nada. Declararlo es lo que hace que el timer funcione; `exported`
             es obligatorio desde targetSdk 31 y va en false porque solo lo
             dispara el AlarmManager de esta misma app. -->
        <receiver
            android:name=".notification.AlarmBroadcast"
            android:exported="false" />
    </application>

</manifest>
