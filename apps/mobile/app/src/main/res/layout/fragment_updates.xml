<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/updates_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/apollo_button_ghost"
                android:stateListAnimator="@null"
                android:text="Volver"
                android:textColor="@color/apollo_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Actualizaciones"
                android:textColor="@color/apollo_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/apollo_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Versión instalada"
                android:textColor="@color/apollo_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/updates_installed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/apollo_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Canal"
                android:textColor="@color/apollo_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/updates_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/apollo_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Estado"
                android:textColor="@color/apollo_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/updates_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/apollo_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/updates_notes_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Notas de la versión"
                android:textColor="@color/apollo_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updates_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/apollo_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/updates_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="52dp"
            android:background="@drawable/apollo_button_primary"
            android:stateListAnimator="@null"
            android:text="Comprobar actualizaciones"
            android:textColor="#04201F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/updates_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:background="@drawable/apollo_button_primary"
            android:stateListAnimator="@null"
            android:text="Instalar"
            android:textColor="#04201F"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Apollo nunca descarga ni instala solo: la descarga empieza únicamente cuando lo pedís."
            android:textColor="@color/apollo_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
