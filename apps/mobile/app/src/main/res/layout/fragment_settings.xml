<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuración"
            android:textColor="@color/apollo_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Personalizá Apollo a tu manera."
            android:textColor="@color/apollo_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="APARIENCIA"
            android:textColor="@color/apollo_muted"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/apollo_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tema"
                android:textColor="@color/apollo_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/apollo_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Idioma"
                android:textColor="@color/apollo_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Español"
                android:textColor="@color/apollo_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CONEXIÓN"
            android:textColor="@color/apollo_muted"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:textAllCaps="true" />

        <LinearLayout
            android:id="@+id/settings_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/apollo_card"
            android:orientation="vertical"
            android:padding="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SISTEMA"
            android:textColor="@color/apollo_muted"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:textAllCaps="true" />

        <Button
            android:id="@+id/settings_updates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="52dp"
            android:background="@drawable/apollo_button_ghost"
            android:stateListAnimator="@null"
            android:text="Actualizaciones"
            android:textColor="@color/apollo_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="52dp"
            android:background="@drawable/apollo_button_ghost"
            android:stateListAnimator="@null"
            android:text="Dispositivo y conexión"
            android:textColor="@color/apollo_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="52dp"
            android:background="@drawable/apollo_button_ghost"
            android:stateListAnimator="@null"
            android:text="Permisos del sistema"
            android:textColor="@color/apollo_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
