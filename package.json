{
  "name": "apollo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "turbo run dev --filter=!create-heyapollo",
    "dev:agent": "turbo run dev --filter=@apollo/agent",
    "dev:console": "turbo run dev --filter=@apollo/console",
    "dev:wizard": "bun run --cwd apps/wizard dev",

    "build": "turbo run build",
    "deploy": "turbo run deploy",

    "types": "bun run --cwd apps/agent types",
    "typecheck": "bun run --cwd apps/agent typecheck",

    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",

    "test": "bun run --cwd apps/agent test",
    "test:coverage": "bun run --cwd apps/agent test:coverage",

    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "latest",
    "@types/node": "^25.9.5",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.47.0",
    "oxlint": "1.78.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}